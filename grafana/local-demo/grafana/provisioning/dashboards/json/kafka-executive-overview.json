  "description": "LenseIQ Executive Overview \u2014 estate-wide cluster health rollup. Stat row at the top with 7-day sparklines, supported by a worst-clusters table and an estate health history chart.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total clusters",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_LOCAL"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count( count by (job) (kafka_controller_kafkacontroller_activecontrollercount{env=~\"$env\"}) )",
          "legendFormat": "clusters",
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [],
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Healthy",
      "description": "Clusters with offline_partitions = 0 AND under_replicated = 0 AND active_controllers = 1.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_LOCAL"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count( ( max by (job) (kafka_controller_kafkacontroller_offlinepartitionscount{env=~\"$env\"}) == 0 ) and ( max by (job) (kafka_server_replicamanager_underreplicatedpartitions{env=~\"$env\"}) == 0 ) and ( max by (job) (kafka_controller_kafkacontroller_activecontrollercount{env=~\"$env\"}) == 1 ) )",
          "legendFormat": "healthy",
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "mappings": [],
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Degraded",
      "description": "Clusters with under-replicated partitions > 0 but no offline partitions.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_LOCAL"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count( ( max by (job) (kafka_server_replicamanager_underreplicatedpartitions{env=~\"$env\"}) > 0 ) and ( max by (job) (kafka_controller_kafkacontroller_offlinepartitionscount{env=~\"$env\"}) == 0 ) )",
          "legendFormat": "degraded",
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "mappings": [],
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Down",
      "description": "Clusters with offline partitions > 0 OR no active controller.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_LOCAL"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count( ( max by (job) (kafka_controller_kafkacontroller_offlinepartitionscount{env=~\"$env\"}) > 0 ) or ( max by (job) (kafka_controller_kafkacontroller_activecontrollercount{env=~\"$env\"}) != 1 ) )",
          "legendFormat": "down",
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "mappings": [],
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Estate health history (7d)",
      "description": "Stacked count of clusters by status over time. Watch the green bar narrow when something goes wrong.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_LOCAL"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "HEALTHY",
          "expr": "count( ( max by (job) (kafka_controller_kafkacontroller_offlinepartitionscount{env=~\"$env\"}) == 0 ) and ( max by (job) (kafka_server_replicamanager_underreplicatedpartitions{env=~\"$env\"}) == 0 ) and ( max by (job) (kafka_controller_kafkacontroller_activecontrollercount{env=~\"$env\"}) == 1 ) )",
          "legendFormat": "healthy",
          "interval": "5m"
        },
        {
          "refId": "DEGRADED",
          "expr": "count( ( max by (job) (kafka_server_replicamanager_underreplicatedpartitions{env=~\"$env\"}) > 0 ) and ( max by (job) (kafka_controller_kafkacontroller_offlinepartitionscount{env=~\"$env\"}) == 0 ) )",
          "legendFormat": "degraded",
          "interval": "5m"
        },
        {
          "refId": "DOWN",
          "expr": "count( ( max by (job) (kafka_controller_kafkacontroller_offlinepartitionscount{env=~\"$env\"}) > 0 ) or ( max by (job) (kafka_controller_kafkacontroller_activecontrollercount{env=~\"$env\"}) != 1 ) )",
          "legendFormat": "down",
          "interval": "5m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 90,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never",
            "barAlignment": 0,
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "healthy"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "degraded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "down"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Cluster status \u2014 current",
      "description": "One row per cluster with current health signals. Sort columns to find what's hurting.",
      "datasource": {
        "type": "prometheus",
        "uid": "PROMETHEUS_LOCAL"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "URP",
          "expr": "max by (job) (kafka_server_replicamanager_underreplicatedpartitions{env=~\"$env\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "OFF",
          "expr": "max by (job) (kafka_controller_kafkacontroller_offlinepartitionscount{env=~\"$env\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "CTRL",
          "expr": "sum by (job) (kafka_controller_kafkacontroller_activecontrollercount{env=~\"$env\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "BIN",
          "expr": "sum by (job) (kafka_server_brokertopicmetrics_bytesinpersec_oneminuterate{env=~\"$env\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "BOUT",
          "expr": "sum by (job) (kafka_server_brokertopicmetrics_bytesoutpersec_oneminuterate{env=~\"$env\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "TOPICS",
          "expr": "count by (job) ( count by (job, topic) ( kafka_server_brokertopicmetrics_bytesinpersec_oneminuterate{env=~\"$env\", topic!=\"\"} ) )",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "job",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true
            },
            "renameByName": {
              "job": "Cluster",
              "Value #URP": "Under-replicated",
              "Value #OFF": "Offline",
              "Value #CTRL": "Active controllers",
              "Value #BIN": "Bytes in/s",
              "Value #BOUT": "Bytes out/s",
              "Value #TOPICS": "Topics"
            },
            "indexByName": {
              "Cluster": 0,
              "Under-replicated": 1,
              "Offline": 2,
              "Active controllers": 3,
              "Bytes in/s": 4,
              "Bytes out/s": 5,
              "Topics": 6
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Offline",
                "desc": true
              },
              {
                "field": "Under-replicated",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false,
